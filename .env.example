# Sarvam AI API Key (required for real-time STT)
SARVAM_API_KEY=your_sarvam_api_key_here

# OpenAI API Key (required for embeddings and GPT answers)
OPENAI_API_KEY=your_openai_api_key_here

# LLM Configuration (Default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
# LLM_MAX_TOKENS=150

# STT Configuration
STT_LANGUAGE=auto
STT_MODEL=saaras:v4

# Embedding Configuration (Default: local BAAI/bge-small-en-v1.5 on CPU, $0 cost, ~4ms)
# EMBEDDING_PROVIDER=local  # or "openai"
# LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# LOCAL_MODELS_DIR=models

# Knowledge base folder to watch & ingest
DOCS_FOLDER=knowledge_base
